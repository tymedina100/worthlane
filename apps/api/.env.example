DATABASE_URL="postgresql://user:password@localhost:5432/financeapp"
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
# Shared only with the desktop server so API rate limits can identify the
# original desktop client. Generate a separate, strong random value.
WORTHLANE_DESKTOP_PROXY_SECRET="your-desktop-proxy-secret"
POSTHOG_PROJECT_KEY="phc_your_project_key"
POSTHOG_HOST="https://us.i.posthog.com"
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SECRET="your-plaid-sandbox-secret"
PLAID_ENV="sandbox"
# Production /transactions/refresh is a separately billed, optional product.
# Keep false until product access, pricing and spending approval are confirmed.
# Normal /transactions/sync still runs; Sandbox refresh tests remain enabled.
PLAID_TRANSACTIONS_REFRESH_ENABLED="false"
PLAID_TOKEN_ENCRYPTION_KEY="64-char-hex-or-strong-random-string"
PLAID_IOS_REDIRECT_URI="https://links.yourdomain.com/plaid-oauth"
PLAID_ANDROID_PACKAGE_NAME="com.worthlane.mobile"
PLAID_WEB_REDIRECT_URI="http://localhost:3003/accounts"
PLAID_WEBHOOK_URL="https://your-api.example.com/api/plaid/webhook"
CRON_SECRET="your-random-cron-secret-here"
ANTHROPIC_API_KEY="sk-ant-your-api-key"
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Worthlane <no-reply@yourdomain.com>"
EMAIL_REPLY_TO="support@worthlane.app"
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_ENVIRONMENT="development"
SENTRY_AUTH_TOKEN="sntrys_your_auth_token"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="worthlane-api"

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json",
      "/railway.json",
      "/nixpacks.toml",
      "/tsconfig.base.json",
      "/.npmrc"
    ],
    "buildCommand": "pnpm install --no-frozen-lockfile && pnpm --filter @worthlane/db db:generate && pnpm --filter @worthlane/api build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @worthlane/db db:migrate:deploy && pnpm --filter @worthlane/api start",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120
  }
}
